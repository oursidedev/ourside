NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public marketing site and authenticated product are separate hosts.
NEXT_PUBLIC_MARKETING_URL=https://getourside.com
NEXT_PUBLIC_APP_URL=https://app.getourside.com
NEXT_PUBLIC_APP_NAME=Ourside
NEXT_PUBLIC_DOMAIN=getourside.com
NEXT_PUBLIC_APP_DOMAIN=app.getourside.com

# Email provider adapters remain server-only. Never prefix private keys with NEXT_PUBLIC_.
EMAIL_PROVIDER=mock
EMAIL_FROM="Ourside <hello@getourside.com>"
EMAIL_REPLY_TO="support@getourside.com"
RESEND_API_KEY=

# Internal admin access. Server-side checks also verify public.admin_users.
ADMIN_EMAILS=ourside.dev@gmail.com

# Privacy-conscious first-party operational analytics.
NEXT_PUBLIC_ANALYTICS_ENABLED=true
ANALYTICS_LIVE_WINDOW_SECONDS=60

# Plans remain database-driven even while checkout uses the mock provider.
BILLING_PROVIDER=mock
NEXT_PUBLIC_PUBLIC_PLANS_ENABLED=true
# Development only. Production builds ignore mock billing regardless of this value.
BILLING_MOCK_ENABLED=true
